[Unit]
Description=gstscope - GStreamer pipeline profiler and RTSP stream checker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/default/gstscope
ExecStart=/usr/bin/gstscope serve
Restart=on-failure
RestartSec=3
RuntimeDirectory=gstscope
RuntimeDirectoryMode=0755
StateDirectory=gstscope
Nice=10

[Install]
WantedBy=multi-user.target
